# ══════════════════════════════════════════════════════════════════
#  SITM-MIO — Variables de entorno
#  Copia este archivo como .env y ajusta los valores para tu entorno.
#  NUNCA subas .env al repositorio.
# ══════════════════════════════════════════════════════════════════

# ── Servidor web ───────────────────────────────────────────────────
SERVER_PORT=8080

# ── Base de datos ──────────────────────────────────────────────────
# Desarrollo: H2 en memoria (efímera, se pierde al reiniciar)
DB_URL=jdbc:h2:mem:sitmmiodb;DB_CLOSE_DELAY=-1
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# Producción: descomentar y configurar PostgreSQL
# DB_URL=jdbc:postgresql://localhost:5432/sitmmiodb
# DB_DRIVER=org.postgresql.Driver
# DB_USERNAME=sitmmio_user
# DB_PASSWORD=CAMBIAR_EN_PRODUCCION
# DB_DDL_AUTO=validate

# Consola H2 (solo desarrollo — deshabilitar en producción)
H2_CONSOLE_ENABLED=true
H2_CONSOLE_PATH=/h2-console

# ── Servidor ICE (ZeroC ICE RPC) ───────────────────────────────────
# Puerto de escucha para conexiones de buses remotos
ICE_PORT=10000

# ── Persistencia CSV ───────────────────────────────────────────────
CSV_PATH=data/datagramas_live.csv
CSV_FLUSH_EVERY=50

# ── Concurrencia ───────────────────────────────────────────────────
THREAD_POOL_SIZE=5

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL_SITMMIO=INFO

# ── Usuarios semilla (solo desarrollo) ────────────────────────────
# Creados automáticamente por DatabaseConfig.java al arrancar
# ADMIN:        admin / admin123
# CONTROLADOR1: controlador1 / ctrl123  →  Zona Norte
# CONTROLADOR2: controlador2 / ctrl123  →  Zona Sur
